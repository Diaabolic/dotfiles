# bsp, stack or float
yabai -m config layout bsp

yabai -mc config window_placement second_child

#padding
yabai -m config top_padding 8
yabai -m config bottom_padding 8
yabai -m config left_padding 8
yabai -m config right_padding 8
yabai -m config window_gap 8

# mouse settings

yabai -m config mouse_follows_focus on

yabai -m config mouse_modifier alt
#left click + drag
yabai -m config mouse_action1 move
#right click + drag
yabai -m config mouse_action2 resize

yabai -m config mouse_drop_action swap

#Disable specific apps
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^CleanMyMac X$" manage=off
yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add app="^Photos$" manage=off
yabai -m rule --add app="^App Store$" manage=off
yabai -m rule --add app="^NordVPN$" manage=off
yabai -m rule --add app="^Preview$" manage=off
yabai -m rule --add app="^WhatsApp$" manage=off
yabai -m rule --add app="^Min$" manage=off
yabai -m rule --add app="^Numi$" manage=off
# Parallels rules
yabai -m rule --add app="^Parallels Desktop$" manage=off
yabai -m rule --add title="^Parallels Desktop$" manage=off
yabai -m rule --add window_role="^AXUnknown$" manage=off
yabai -m rule --add app="^prl_client_app$" manage=off
yabai -m rule --add app="^Windows 11$" manage=off
